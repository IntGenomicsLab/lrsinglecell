/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests of the oarfish quantifier
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test
    of the transcriptome arm: transcriptome alignment, GROUP_TRANSCRIPTS, SPLIT_BAM,
    per-contig deduplication and OARFISH.

    Use as follows:
        nextflow run IntGenomicsLab/lrsinglecell -profile test_oarfish,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'oarfish test profile'
    config_profile_description = 'Minimal test dataset to check the oarfish (transcriptome) quantification path'

    // Input data
    input                = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_test.csv'

    // Genome references. No `transcript_fasta` on purpose: the transcriptome is
    // extracted from the genome and gtf with gffread, which is the path this
    // profile exercises.
    genome_fasta         = params.pipelines_testdata_base_path + 'reference/chr21.fa'
    gtf                  = params.pipelines_testdata_base_path + 'reference/chr21.gtf'

    // Barcode options
    barcode_format       = "10X_3v3"

    // Analysis options
    quantifier           = "isoquant,oarfish"

}
