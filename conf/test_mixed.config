/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running mixed DNA/cDNA tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test
    with both DNA and cDNA samples (multiome).

    Use as follows:
        nextflow run IntGenomicsLab/lrsinglecell -profile test_mixed,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test Mixed (Multiome) profile'
    config_profile_description = 'Minimal test dataset to check both DNA and cDNA pipeline function'

    // Input data
    input                = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_test_mixed.csv'

    // Genome references
    genome_fasta         = params.pipelines_testdata_base_path + 'reference/chr21.fa'
    gtf                  = params.pipelines_testdata_base_path + 'reference/chr21.gtf'

    // Barcode options
    barcode_format       = "10X_multiome"

    // Demultiplexing tool - both use flexiplex for multiome
    demux_tool_cdna      = "flexiplex"
    demux_tool_dna       = "flexiplex"

    // Analysis options
    quantifier           = "isoquant"

}
